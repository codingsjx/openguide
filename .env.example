# OpenGuide 环境变量示例 —— 复制为 .env 后按需填写。
#
#   cp .env.example .env
#
# 本文件只放占位符，**绝不提交真实 Key**（CI 有密钥扫描，见 .github/workflows/ci.yml）。
# docker compose 会自动读取同目录的 .env；本地直接跑后端时，把同样的内容放到
# backend/.env 即可（两份内容一致）。

# ---- GitHub API ----
# 可选。留空则以未认证方式访问，限流更低（约 60 次/小时）。
# 填一个只读 token 可显著提升限流额度，演示更稳。
GITHUB_TOKEN=

# ---- 大模型（可选）----
# 留空则生成走**确定性启发式**路径（无需任何 Key，演示与 CI 默认如此）。
# 填任意 [OI] 兼容端点即可启用 AI 生成。使用第三方服务前请阅读
# docs/third_party_disclosure.md。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5

# ---- 向量检索 ----
# false（默认）：确定性 token 重叠检索，零下载、秒级启动，适合演示与离线评审。
# true：本地 chromadb + 嵌入模型，首次启动会下载模型（约数百 MB）。
USE_CHROMA=false

# ---- 后端调优（一般无需修改）----
# GITHUB_TIMEOUT_S=15
# HTTP_CACHE_TTL_S=3600
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# VECTORSTORE_DIR=.chroma
